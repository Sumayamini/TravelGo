{
  "name": "travelgo",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/web", "apps/mobile"],
  "scripts": {
    "dev:web": "npm run dev --workspace @travelgo/web",
    "dev:mobile": "npm run start --workspace @travelgo/mobile",
    "lint:web": "npm run lint --workspace @travelgo/web",
    "lint:mobile": "npm run lint --workspace @travelgo/mobile",
    "typecheck:web": "npm run typecheck --workspace @travelgo/web",
    "typecheck:mobile": "npm run typecheck --workspace @travelgo/mobile"
  }
}
